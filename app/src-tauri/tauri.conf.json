{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Haul",
  "mainBinaryName": "haul",
  "version": "0.2.1",
  "identifier": "dev.haul.desktop.dev",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm --prefix ../extension run build && npm run build",
    "beforeBundleCommand": "node ../extension/check-release.mjs"
  },
  "app": {
    "windows": [
      {
        "title": "Haul",
        "width": 1280,
        "height": 800,
        "minWidth": 1080,
        "minHeight": 640,
        "dragDropEnabled": false,
        "visible": false
      }
    ],
    "security": {
      "capabilities": [
        "default",
        "dev-test"
      ],
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/7zip/*": "7zip/",
      "../../extension/dist/": "extension/",
      "../../extension/firefox/": "firefox/",
      "../../LICENSE-MIT": "LICENSE-MIT",
      "../../LICENSE-APACHE": "LICENSE-APACHE"
    },
    "publisher": "The Haul contributors",
    "copyright": "Copyright (c) 2026 The Haul contributors",
    "shortDescription": "A download manager for Windows",
    "license": "MIT OR Apache-2.0",
    "licenseFile": "../../LICENSE-MIT",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false,
        "installerHooks": "installer-hooks.nsh",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
