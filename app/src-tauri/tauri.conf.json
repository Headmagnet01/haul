{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Haul",
  "mainBinaryName": "haul",
  "version": "0.1.0",
  "identifier": "dev.haul.desktop.dev",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Haul",
        "width": 1280,
        "height": 800,
        "minWidth": 1080,
        "minHeight": 640,
        "dragDropEnabled": false,
        "visible": false
      }
    ],
    "security": {
      "capabilities": ["default", "dev-test"],
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/7zip/*": "7zip/"
    }
  }
}
